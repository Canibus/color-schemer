{
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "devPath": "http://localhost:1420",
    "distDir": "../dist"
  },
  "package": {
    "productName": "color-schemer",
    "version": "0.1.0"
  },
  "tauri": {
    "windows": [
      {
        "label": "main",
        "title": "color-schemer",
        "width": 520,
        "height": 680,
        "resizable": true,
        "visible": false,
        "decorations": false,
        "transparent": true
      }
    ],
    "allowlist": {
      "all": false,
      "window": {
        "all": false,
        "close": true,
        "minimize": true,
        "maximize": false,
        "show": true,
        "hide": true,
        "setFocus": true,
        "startDragging": true
      },
      "shell": {
        "all": false,
        "open": true
      }
    },
    "security": {
      "csp": null
    },
    "bundle": {
      "active": true,
      "targets": ["msi", "nsis", "updater"],
      "identifier": "io.github.canibus.colorschemer",
      "icon": ["icons/icon.ico", "icons/icon.png"]
    },
    "systemTray": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true
    },
    "updater": {
      "active": true,
      "endpoints": [
        "https://raw.githubusercontent.com/canibus/color-schemer/gh-pages/update.json"
      ],
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNGODVEMkQ5RTVEMDA3N0IKUldSN0I5RGwyZEtGUDBoYmpjYm8zU1FWbmFyMHlxaGhBbFhIak5oNk1Ibmx0TkhPenBLQ0N5d2sK"
    }
  }
}
