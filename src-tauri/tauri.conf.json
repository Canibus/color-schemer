{
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "devPath": "http://localhost:1420",
    "distDir": "../dist"
  },
  "package": {
    "productName": "color-schemer",
    "version": "0.1.0"
  },
  "tauri": {
    "windows": [
      {
        "title": "color-schemer",
        "width": 520,
        "height": 680,
        "resizable": true,
        "visible": false,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    },
    "bundle": {
      "active": true,
      "targets": ["msi", "nsis"],
      "identifier": "com.twentin.color-schemer",
      "icon": ["icons/icon.ico", "icons/icon.png"]
    },
    "systemTray": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true
    }
  }
}

